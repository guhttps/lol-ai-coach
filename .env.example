# API de respostas do coach: provedor compatível com OpenAI Chat Completions.
# Para Groq, sem LLM_MODEL, o coach tenta os modelos disponíveis abaixo.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=

# Usada para transcrição de voz pela Groq e compatibilidade com instalações antigas.
# Crie uma chave gratuita em https://console.groq.com/keys
GROQ_API_KEY=cole_sua_chave_aqui

# Overlay sempre no topo (true/false)
COACH_OVERLAY=true
